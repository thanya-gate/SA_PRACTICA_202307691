PORT=3000
NODE_ENV=development

ALLOWED_EMAIL_DOMAINS=ingenieria.usac.edu.gt,ing.usac.edu.gt

JWT_SECRET=change-me-in-prod-usa-una-clave-de-64-bytes
JWT_EXPIRES_IN=10m
JWT_ISSUER=yousac-auth
JWT_AUDIENCE=yousac-gateway

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_PATH=/
SESSION_COOKIE_NAME=yousac_session

MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPTS_WINDOW_MIN=15

OAUTH_MOCK_ENABLED=true
OAUTH_MOCK_ISSUER=http://localhost:3000/mock-oauth
OAUTH_REDIRECT_URI=http://localhost:3000/auth/oauth/callback

GRPC_PORT=50051

DATABASE_URL=postgresql://yousac:yousac_secret@localhost:5432/yousac_auth
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
