{
  "name": "@yousac/catalog-service",
  "version": "1.0.0",
  "description": "Microservicio de Catálogo, Búsqueda y Detalle de Clases (YoUSAC) - TypeScript/gRPC/PostgreSQL",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "proto:gen": "grpc_tools_node_protoc --js_out=import_style=commonjs,binary:src/interfaces/grpc/generated --grpc_out=grpc_js:src/interfaces/grpc/generated --ts_out=grpc_js:src/interfaces/grpc/generated -I ../proto ../proto/catalogo.proto"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^16.4.7",
    "pg": "^8.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.3",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "^1.12.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
