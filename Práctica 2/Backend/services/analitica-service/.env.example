# Puerto gRPC del microservicio de Analítica (east-west, no publicado).
GRPC_PORT=50054

# Conexión a la BD del microservicio (Database per Microservice).
DATABASE_URL=postgresql://yousac:yousac_secret@localhost:5435/yousac_analitica

# URL de Redis (capa de caché con políticas TTL).
REDIS_URL=redis://localhost:6379/0

# TTL (segundos) de las consultas cacheadas.
CACHE_TTL_MAS_VISTAS=300
CACHE_TTL_TENDENCIAS=600
CACHE_TTL_RANKING=900
CACHE_TTL_RECOMENDACIONES=600
