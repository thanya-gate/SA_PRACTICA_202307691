# Copiar a .env en la carpeta de despliegue de la VM y sustituir cada valor.
# No subir el archivo .env real al repositorio.

REGISTRY_IMAGENES=ghcr.io/thanya-gate
IMAGE_TAG=2.0.0

# La VM comparte el host con YouSAC. Mantener APIs, datos y consola de RabbitMQ
# ligados a localhost evita colisiones y exposición directa; Caddy los publica
# por HTTPS en https://136.119.139.125.sslip.io.
PUERTO_RESERVAS_HTTP=127.0.0.1:18080
PUERTO_CATALOGO_HTTP=127.0.0.1:18081
PUERTO_CERTIFICADOS_HTTP=127.0.0.1:18082
PUERTO_BROKER_CONSOLA=127.0.0.1:25672
PUERTO_REDIS=127.0.0.1:16379
PUERTO_DB_CATALOGO=127.0.0.1:25432
PUERTO_DB_RESERVAS=127.0.0.1:25433
PUERTO_DB_CREDENCIALES=127.0.0.1:25434

DB_USUARIO=academix
DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_LARGO
DB_CATALOGO_NOMBRE=academix_catalogo
DB_RESERVAS_NOMBRE=academix_reservas
DB_CREDENCIALES_NOMBRE=academix_credenciales

BROKER_USUARIO=academix
BROKER_PASSWORD=CAMBIAR_POR_OTRO_SECRETO_LARGO
CLAVE_FIRMA_PASE=GENERAR_UNA_CLAVE_ALEATORIA_LARGA

# Origen de producción del frontend en Vercel.
CORS_ORIGENES=https://sa-practica7.vercel.app

LOG_LEVEL=INFO
