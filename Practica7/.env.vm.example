# Copiar a .env en la carpeta de despliegue de la VM y sustituir cada valor.
# No subir el archivo .env real al repositorio.

REGISTRY_IMAGENES=ghcr.io/thanya-gate
IMAGE_TAG=2.0.0

DB_USUARIO=academix
DB_PASSWORD=CAMBIAR_POR_UN_SECRETO_LARGO
DB_CATALOGO_NOMBRE=academix_catalogo
DB_RESERVAS_NOMBRE=academix_reservas
DB_CREDENCIALES_NOMBRE=academix_credenciales

BROKER_USUARIO=academix
BROKER_PASSWORD=CAMBIAR_POR_OTRO_SECRETO_LARGO
CLAVE_FIRMA_PASE=GENERAR_UNA_CLAVE_ALEATORIA_LARGA

# Reemplazar por el origen exacto del frontend publicado en Vercel.
CORS_ORIGENES=https://TU-PROYECTO.vercel.app

LOG_LEVEL=INFO
