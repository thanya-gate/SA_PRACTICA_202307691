# =====================================================================
# Endpoints del backend SOA desplegado en la Maquina Virtual
# =====================================================================
# Estas variables son la UNICA forma de cambiar de destino. En desarrollo
# local apuntan a la VM levantada con el docker-compose de la practica
# (localhost:8080, 8081, 8082). En Vercel se sobreescriben con la IP
# publica o el dominio de la VM de desarrollo.
#
# Next.js las reemplaza por su valor literal AL COMPILAR. Cambiar una
# variable exige reconstruir y volver a desplegar: editarla en el panel
# de Vercel no basta si el valor no estaba presente durante el build.
# ---------------------------------------------------------------------

# Destino comun para los tres servicios. Util solo si la VM publica el
# catalogo, el productor y los certificados bajo el mismo dominio (por
# ejemplo detras de un proxy inverso con reglas de ruta).
# NEXT_PUBLIC_API_BASE=http://IP_DE_LA_VM

# Por servicio. Tiene prioridad sobre NEXT_PUBLIC_API_BASE.
# Servicio de Catalogo de Talleres (TypeScript) -> puerto 8081
NEXT_PUBLIC_API_CATALOGO_BASE=http://localhost:8081
# Servicio de Reservas / Ticketing, productor (Go) -> puerto 8080
NEXT_PUBLIC_API_RESERVAS_BASE=http://localhost:8080
# Servicio de Certificados (TypeScript) -> puerto 8082
NEXT_PUBLIC_API_CERTIFICADOS_BASE=http://localhost:8082

# ---------------------------------------------------------------------
# Ajuste del cliente HTTP
# ---------------------------------------------------------------------
# Milisegundos que se espera a la VM antes de cortar la peticion.
NEXT_PUBLIC_API_TIMEOUT_MS=10000
# Periodo del polling del seguimiento mientras el worker no responde.
NEXT_PUBLIC_API_POLLING_MS=2500
# Intentos de polling antes de pedir actualizacion manual.
NEXT_PUBLIC_API_POLLING_MAX_INTENTOS=24

# ---------------------------------------------------------------------
# Variable equivalente del LADO DE LA VM (NO va en Vercel)
# ---------------------------------------------------------------------
# docker-compose.yml la lee para CORS_ORIGENES. Debe incluir el dominio
# exacto del despliegue en Vercel; con "*" el navegador acepta cualquier
# origen, lo cual sirve para una defensa pero no para produccion.
#
# CORS_ORIGENES=https://tu-proyecto.vercel.app

# ---------------------------------------------------------------------
# Aviso sobre HTTPS en Vercel
# ---------------------------------------------------------------------
# Vercel sirve el sitio por HTTPS y el navegador bloquea las peticiones
# HTTP hacia una IP publica (mixed content). Los valores de arriba sirven
# para desarrollo local contra el compose; en Vercel hay que apuntar a un
# dominio o tunel con TLS (https://...), no a http://IP:PUERTO.