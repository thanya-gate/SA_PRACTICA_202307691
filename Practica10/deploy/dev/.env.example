# Variables del entorno Dev. deploy-dev.sh genera el .env real en la VM con
# credenciales aleatorias; este archivo solo documenta qué se define.
REGISTRY_IMAGENES=ghcr.io/thanya-gate
IMAGE_TAG=3.0.0
LOG_LEVEL=INFO
CORS_ORIGENES=https://sa-practica7.vercel.app
DB_USUARIO=academix
DB_PASSWORD=cambiar
BROKER_USUARIO=academix
BROKER_PASSWORD=cambiar
CLAVE_FIRMA_PASE=cambiar
# Todo ligado a 127.0.0.1: solo Caddy (80/443) queda expuesto a internet.
PUERTO_RESERVAS_HTTP=127.0.0.1:18080
PUERTO_CATALOGO_HTTP=127.0.0.1:18081
PUERTO_CERTIFICADOS_HTTP=127.0.0.1:18082
PUERTO_BROKER_CONSOLA=127.0.0.1:15672
PUERTO_REDIS=127.0.0.1:6379
PUERTO_DB_CATALOGO=127.0.0.1:5432
PUERTO_DB_RESERVAS=127.0.0.1:5433
PUERTO_DB_CREDENCIALES=127.0.0.1:5434
